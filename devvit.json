{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "destinyvox",
  "dev": {
    "subreddit": "DestinyVox"
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "media": {
    "dir": "public"
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "destinyvox",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Apagar todos comentários do bot",
        "description": "Deleta todos comentários feitos pelo bot destinyvox",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/delete-bot-comments"
      },
      {
        "label": "✦ Alternar Status VIP (Dev)",
        "description": "Ativa ou desativa o status VIP no Redis para testes do Oráculo",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/toggle-vip"
      }
    ]
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "asUser": [
        "SUBMIT_POST",
        "SUBMIT_COMMENT",
        "SUBSCRIBE_TO_SUBREDDIT"
      ]
    },
    "http": {
      "enable": true,
      "domains": [
        "generativelanguage.googleapis.com"
      ]
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onCommentCreate": "/internal/triggers/on-comment-create"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}