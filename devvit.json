{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "dgapp",
  "dev": {
    "subreddit": "DestinyVox"
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "media": {
    "dir": "public"
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "dgapp",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Apagar todos comentários do bot",
        "description": "Deleta todos comentários feitos pelo bot dgapp",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/delete-bot-comments"
      }
    ]
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "asUser": ["SUBMIT_POST", "SUBMIT_COMMENT", "SUBSCRIBE_TO_SUBREDDIT"]
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onCommentCreate": "/internal/triggers/on-comment-create"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
